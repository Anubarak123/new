# Copy this file to `.env` and fill in the values below.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# API listening port. Render supplies PORT automatically.
PORT=3001

# Signing secret for login tokens. Must be at least 32 characters.
JWT_SECRET="replace-with-at-least-32-random-characters"

# Allowed browser origin for CORS. Leave unset when the API serves the SPA.
CLIENT_URL="http://localhost:5173"

# Set to production to serve the compiled React SPA from client/dist.
NODE_ENV=development

# Seed account details. PROFESSOR_PASSWORD is required before `npm run db:seed`.
PROFESSOR_USERNAME="professor"
PROFESSOR_PASSWORD=""
PROFESSOR_NAME="Professor"

# Optional logo storage directory.
UPLOAD_DIR=""

# Optional custom Vite development API target.
API_PROXY_TARGET=""

# Trusted reverse proxy count. Set 1 on Render, leave unset locally.
TRUST_PROXY_HOPS=""
